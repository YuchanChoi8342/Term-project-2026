# 7. 제출물 자동 검수 (audit)
# ======================================================================
@dataclass
class SubFile:
    name: str                     # 제출물 안에서의 상대 경로
    size: int
    reader: Callable[[], bytes]

    @property
    def ext(self) -> str:
        return Path(self.name).suffix.lower().lstrip(".")

    @property
    def base(self) -> str:
        return Path(self.name).name


@dataclass
class AuditItem:
    level: str  # 통과 / 경고 / 확인
    message: str


PLACEHOLDER_RX = {
    "학번": r"\d{6,12}", "id": r"\d{6,12}", "studentid": r"\d{6,12}", "student_id": r"\d{6,12}",
    "이름": r"[가-힣A-Za-z]{2,}", "성명": r"[가-힣A-Za-z]{2,}", "name": r"[가-힣A-Za-z]{2,}",
    "번호": r"\d+", "주차": r"\d+", "과제번호": r"\d+", "차수": r"\d+", "no": r"\d+",
    "분반": r"\w+", "팀명": r"[^_\-\s.]+", "팀": r"[^_\-\s.]+", "조": r"\d*", "과목": r"[^_\-\s.]+",
    "과목명": r"[^_\-\s.]+", "날짜": r"\d{4,8}",
}
FILENAME_RE = re.compile(r"파일\s*(?:명|이름)\s*(?:은|는|을|를)?\s*[:：]?\s*[\"'“‘`]?([^\s,;\"'”’`]+)|"
                         r"file\s*name\s*(?:is|:)?\s*[\"'`]?([^\s,;\"'`]+)", re.I)
DOT_EXT_RE = re.compile(r"\.(py|pdf|zip|docx?|hwpx?|txt|md|pptx?|ipynb|csv|xlsx?|java|cpp|c|png|jpe?g|mp4)\b", re.I)
BARE_EXT_RE = re.compile(r"\b(pdf|zip|hwpx?|docx|pptx|ipynb|xlsx)\b", re.I)
OR_RE = re.compile(r"또는|혹은|\bor\b|중\s*(?:하나|택)|/")
EN_GENERIC = {
    "the", "not", "allowed", "use", "using", "must", "library", "libraries", "external", "standard", "only",
    "python", "import", "code", "file", "files", "third", "party", "and", "for", "any", "with", "are",
    "you", "may", "can", "should", "extra", "other", "pip", "install", "module", "modules", "package",
    "packages", "no", "do", "don", "allow", "pdf", "zip", "hwp", "txt", "docx", "pptx", "ai", "lms",
}
LIB_ALIAS = {"scikit-learn": "sklearn", "opencv": "cv2", "pytorch": "torch", "beautifulsoup": "bs4", "pillow": "pil"}
JUNK_RE = re.compile(r"(?:^|/)(?:__pycache__|\.git|\.idea|\.vscode|venv|\.venv|node_modules)(?:/|$)|"
                     r"\.DS_Store$|Thumbs\.db$|\.pyc$", re.I)
DOC_NOUNS = [
    ("보고서", re.compile(r"보고서|report", re.I), re.compile(r"보고서|report", re.I),
     {"pdf", "docx", "doc", "hwp", "hwpx", "md", "txt"}),
    ("README", re.compile(r"readme", re.I), re.compile(r"readme", re.I), {"md", "txt"}),
    ("소스코드", re.compile(r"소스\s*코드|source\s*code|코드", re.I), re.compile(r"$^"),
     {"py", "java", "c", "cpp", "ipynb", "js"}),
    ("발표자료", re.compile(r"발표\s*(?:자료|슬라이드)|슬라이드|\bppt\b", re.I), re.compile(r"발표|slide|ppt", re.I),
     {"pptx", "ppt", "pdf"}),
    ("스크린샷", re.compile(r"스크린\s*샷|캡처|screenshot", re.I), re.compile(r"스크린|캡처|screen", re.I),
     {"png", "jpg", "jpeg"}),
    ("실행 결과", re.compile(r"실행\s*(?:결과|화면)", re.I), re.compile(r"결과|result|output", re.I),
     {"png", "jpg", "jpeg", "txt", "pdf"}),
    ("requirements", re.compile(r"requirements", re.I), re.compile(r"requirements", re.I), {"txt"}),
]


def build_filename_regex(template: str) -> Optional[re.Pattern]:
    """'학번_이름.zip' 같은 안내문 속 파일명 규칙을 정규식으로 변환."""
    tpl = template.strip("'\"`“”‘’「」『』")
    if not re.search(r"[_.\-\[<]", tpl):
        return None
    parts = re.split(r"([\[\]<>{}()（）]+|[_\-.\s]+)", tpl)
    rx = ""
    for part in parts:
        if not part:
            continue
        if re.fullmatch(r"[\[\]<>{}()（）]+", part):
            continue
        if re.fullmatch(r"[_\-.\s]+", part):
            rx += re.escape(part)
            continue
        rx += PLACEHOLDER_RX.get(part) or PLACEHOLDER_RX.get(part.lower()) or re.escape(part)
    try:
        return re.compile(rx, re.I)
    except re.error:
        return None


def collect_submission(path: str) -> tuple[list[SubFile], bool, int]:
    """(파일 목록, zip 파일 여부, 전체 크기). 폴더·zip·단일 파일을 모두 지원."""
    p = Path(path)
    if p.is_dir():
        files = [SubFile(f.relative_to(p).as_posix(), f.stat().st_size, f.read_bytes)
                 for f in sorted(p.rglob("*")) if f.is_file()]
        return files, False, sum(f.size for f in files)
    if p.is_file() and p.suffix.lower() == ".zip" and zipfile.is_zipfile(p):
        zf = zipfile.ZipFile(p)
        files = []
        for info in zf.infolist():
            if info.is_dir():
                continue
            name = info.filename
            try:  # 윈도우 한글 zip의 깨진 이름 복구 시도
                name = name.encode("cp437").decode("cp949")
            except (UnicodeEncodeError, UnicodeDecodeError):
                pass
            files.append(SubFile(name, info.file_size, (lambda n=info.filename: zf.read(n))))
        return files, True, p.stat().st_size
    if p.is_file():
        return [SubFile(p.name, p.stat().st_size, p.read_bytes)], False, p.stat().st_size
    sys.exit(f"제출물을 찾을 수 없습니다: {path}")


def decode_bytes(raw: bytes) -> str:
    for enc in ("utf-8-sig", "cp949"):
        try:
            return raw.decode(enc)
        except UnicodeDecodeError:
            continue
    return raw.decode("utf-8", errors="replace")


def stdlib_names() -> set[str]:
    names = getattr(sys, "stdlib_module_names", None)
    if names:
        return set(names)
    return {"abc", "argparse", "ast", "collections", "csv", "datetime", "functools", "heapq", "itertools",
            "json", "math", "os", "pathlib", "random", "re", "statistics", "string", "sys", "time",
            "typing", "dataclasses", "enum", "copy", "decimal", "fractions", "io", "operator", "queue",
            "sqlite3", "struct", "textwrap", "unittest", "zipfile", "__future__"}


def fmt_size(n: float) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.1f}{unit}" if unit != "B" else f"{int(n)}B"
        n /= 1024
    return f"{n}B"


def run_audit(notice_text: str, target: str) -> list[AuditItem]:
    files, is_zip, total_size = collect_submission(target)
    sentences = split_sentences(notice_text)
    cls = [(s, classify_sentence(s)) for s in sentences]
    items: list[AuditItem] = []
    add = lambda level, msg: items.append(AuditItem(level, msg))  # noqa: E731
    exts_present = {f.ext for f in files}

    if not files:
        return [AuditItem("경고", "제출물이 비어 있습니다.")]
    add("통과", f"제출물 {len(files)}개 파일, 총 {fmt_size(total_size)}")

    # 1) 필수·금지 파일 형식
    groups: list[frozenset] = []
    forbidden: set[str] = set()
    for s, c in cls:
        exts = {m.group(1).lower() for m in DOT_EXT_RE.finditer(s.text)} | \
               {m.group(1).lower() for m in BARE_EXT_RE.finditer(s.text)}
        exts = {"jpg" if e == "jpeg" else e for e in exts}
        if not exts:
            continue
        if c and c[0] == "금지":
            forbidden |= exts
        elif DEADLINE_SENT_RE.search(s.text) or (c and c[0] in ("제출", "포함", "형식", "필수")):
            if len(exts) > 1 and OR_RE.search(s.text):
                groups.append(frozenset(exts))
            else:
                groups.extend(frozenset([e]) for e in exts)
    seen_groups: set[frozenset] = set()
    for g in groups:
        if g in seen_groups:
            continue
        seen_groups.add(g)
        label = " 또는 ".join(f".{e}" for e in sorted(g))
        if g == frozenset({"zip"}):
            if is_zip:
                add("통과", "압축 파일(.zip) 형식으로 제출됨")
            else:
                add("확인", "안내문은 .zip 제출을 요구함 → 이 폴더를 zip으로 압축했는지 확인하세요")
        elif {"jpg" if e == "jpeg" else e for e in exts_present} & {"jpg" if e == "jpeg" else e for e in g}:
            add("통과", f"필수 형식 {label} 파일이 있음")
        else:
            add("경고", f"필수 형식 {label} 파일이 보이지 않음")
    for e in sorted(forbidden):
        if e in exts_present:
            names = ", ".join(f.base for f in files if f.ext == e)[:80]
            add("경고", f"금지된 형식 .{e} 파일이 포함됨: {names}")

    # 2) 파일명 규칙
    templates = []
    for s, _ in cls:
        for m in FILENAME_RE.finditer(s.text):
            tpl = m.group(1) or m.group(2)
            rx = build_filename_regex(tpl) if tpl else None
            if rx:
                templates.append((tpl, rx))
    for tpl, rx in templates[:2]:
        tpl_ext = Path(tpl.strip("'\"`")).suffix.lower().lstrip(".")
        if is_zip and (not tpl_ext or tpl_ext == "zip"):
            cands = [Path(target).name]
        else:
            cands = [f.base for f in files if not tpl_ext or f.ext == tpl_ext]
        if not cands:
            add("확인", f"파일명 규칙 '{tpl}' 을(를) 적용할 파일이 없어 확인하지 못함")
            continue
        for name in cands[:5]:
            if rx.fullmatch(name):
                add("통과", f"파일명 '{name}' 이(가) 규칙 '{tpl}' 과 일치")
            else:
                add("경고", f"파일명 '{name}' 이(가) 규칙 '{tpl}' 과 다름 (예: {_sample_name(tpl)})")

    # 3) 용량·쪽수·줄 수·분량
    constraints: list[Constraint] = []
    for s in sentences:
        constraints.extend(extract_constraints(s))
    for c in constraints:
        scale = {"kb": 1 << 10, "mb": 1 << 20, "gb": 1 << 30}.get(c.unit)
        if scale and c.hi != INF:
            limit = c.hi * scale
            big = max(files, key=lambda f: f.size)
            if total_size <= limit:
                add("통과", f"용량 {fmt_size(total_size)} ≤ 제한 '{c.raw}'")
            else:
                add("경고", f"용량 {fmt_size(total_size)} > 제한 '{c.raw}' (가장 큰 파일: {big.base} {fmt_size(big.size)})")
        elif c.unit == "page":
            for f in [f for f in files if f.ext == "pdf"]:
                pages = len(re.findall(rb"/Type\s*/Page(?![s\w])", f.reader()))
                if pages == 0:
                    add("확인", f"{f.base}: 쪽수를 추정하지 못함 (직접 확인 필요, 조건 '{c.raw}')")
                elif c.lo <= pages <= c.hi:
                    add("통과", f"{f.base}: 약 {pages}쪽 (조건 '{c.raw}' 충족, 추정)")
                else:
                    add("경고", f"{f.base}: 약 {pages}쪽 → 조건 '{c.raw}' 불충족 (추정)")
        elif c.unit == "줄":
            for f in [f for f in files if f.ext == "py"]:
                n = len(decode_bytes(f.reader()).splitlines())
                ok = c.lo <= n <= c.hi
                add("통과" if ok else "확인", f"{f.base}: {n}줄 (조건 '{c.raw}' {'충족' if ok else '확인 필요'})")
        elif c.unit in ("단어", "글자"):
            for f in [f for f in files if f.ext in ("txt", "md")]:
                body = decode_bytes(f.reader())
                n = len(body.split()) if c.unit == "단어" else len(re.sub(r"\s", "", body))
                ok = c.lo <= n <= c.hi
                add("통과" if ok else "확인", f"{f.base}: {n}{c.unit} (조건 '{c.raw}' {'충족' if ok else '확인 필요'})")

    # 4) 산출물 이름 점검 (보고서/README/소스코드 ...)
    for label, ask_rx, name_rx, ok_exts in DOC_NOUNS:
        asked = any(c and c[0] in ("제출", "포함") and c[0] != "금지" and ask_rx.search(s.text)
                    and not (c[0] == "금지") for s, c in cls)
        if not asked:
            continue
        if any(name_rx.search(f.base) or f.ext in ok_exts for f in files):
            add("통과", f"'{label}' 관련 파일이 있음")
        else:
            add("경고", f"안내문이 '{label}' 제출을 요구하는 것으로 보이나 해당 파일이 보이지 않음")

    # 5) 파이썬 코드 점검: 문법, import 정책, 하드코딩 경로
    py_files = [f for f in files if f.ext == "py"]
    local_mods = {Path(f.name).stem for f in py_files}
    ban_external = any(EXTERNAL_BAN_RE.search(s.text) and c and (c[0] == "금지" or ONLY_RE.search(s.text))
                       for s, c in cls)
    banned_names: set[str] = set()
    for s, c in cls:
        if c and c[0] == "금지":
            for w in re.findall(r"[A-Za-z][A-Za-z0-9_\-]{2,}", s.text):
                w = w.lower()
                if w not in EN_GENERIC:
                    banned_names.add(LIB_ALIAS.get(w, w))
    std = stdlib_names()
    for f in py_files:
        src = decode_bytes(f.reader())
        try:
            tree = ast.parse(src)
        except SyntaxError as e:
            add("경고", f"{f.base}: 문법 오류 (줄 {e.lineno}) {e.msg}")
            continue
        add("통과", f"{f.base}: 문법 검사 통과")
        imports: set[str] = set()
        for node in ast.walk(tree):
            if isinstance(node, ast.Import):
                imports |= {a.name.split(".")[0] for a in node.names}
            elif isinstance(node, ast.ImportFrom) and node.module and node.level == 0:
                imports.add(node.module.split(".")[0])
        lower_imports = {i.lower() for i in imports}
        hit = sorted(lower_imports & banned_names)
        if hit:
            add("경고", f"{f.base}: 금지된 모듈 import 발견 → {', '.join(hit)}")
        if ban_external:
            third = sorted(i for i in imports if i not in std and i not in local_mods)
            if third:
                add("경고", f"{f.base}: 외부 라이브러리 제한 위반 가능 → {', '.join(third)}")
            else:
                add("통과", f"{f.base}: 표준 라이브러리만 사용")
        if re.search(r"[A-Za-z]:\\\\|[A-Za-z]:\\|/Users/|/home/", src):
            add("경고", f"{f.base}: 절대 경로가 하드코딩된 것 같음 (채점 환경에서 실행 불가 위험)")
        if re.search(r"TODO|FIXME", src):
            add("확인", f"{f.base}: TODO/FIXME가 남아 있음")

    # 6) 불필요 파일
    junk = [f.name for f in files if JUNK_RE.search(f.name)]
    if junk:
        add("확인", f"불필요한 파일이 섞여 있음 ({len(junk)}개): " + ", ".join(junk[:4]) + (" ..." if len(junk) > 4 else ""))
    return items


def _sample_name(tpl: str) -> str:
    out = tpl.strip("'\"`")
    for key, sample in (("학번", "20231234"), ("이름", "홍길동"), ("성명", "홍길동"), ("과제번호", "3"),
                        ("주차", "5"), ("번호", "1")):
        out = out.replace(f"[{key}]", sample).replace(f"<{key}>", sample).replace(key, sample)
    return out


def format_audit(items: list[AuditItem], target: str) -> str:
    mark = {"통과": "[ OK ]", "경고": "[FAIL]", "확인": "[ ?? ]"}
    n_fail = sum(1 for i in items if i.level == "경고")
    n_chk = sum(1 for i in items if i.level == "확인")
    lines = ["=" * 60, " 제출물 자동 검수 보고서", f" 대상: {target}   생성: {datetime.now():%Y-%m-%d %H:%M}", "=" * 60, ""]
    for it in items:
        lines.append(f" {mark[it.level]} {it.message}")
    lines += ["", "-" * 60]
    if n_fail:
        lines.append(f" 결과: 경고 {n_fail}건, 확인 필요 {n_chk}건 → 제출 전에 고치세요.")
    elif n_chk:
        lines.append(f" 결과: 경고 없음, 직접 확인할 항목 {n_chk}건")
    else:
        lines.append(" 결과: 자동 검사를 모두 통과했습니다. 그래도 마감 시각과 제출 위치는 마지막으로 확인하세요.")
    lines.append(" * 쪽수는 PDF 내부 구조로 추정한 값이며, 안내문 해석(정규식)에 의존하므로 최종 판단은 직접 하세요.")
    return "\n".join(lines) + "\n"


# ======================================================================
# 8. 공지 정정 추적기 (diff)
# ======================================================================
def word_diff(old: str, new: str) -> str:
    a, b = re.findall(r"\S+", old), re.findall(r"\S+", new)
    sm = difflib.SequenceMatcher(None, a, b)
    out = []
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        if tag == "equal":
            out.append(" ".join(a[i1:i2]))
        else:
            if i2 > i1:
                out.append("[-" + " ".join(a[i1:i2]) + "-]")
            if j2 > j1:
                out.append("{+" + " ".join(b[j1:j2]) + "+}")
    return " ".join(out)


def diff_requirements(old: list[Requirement], new: list[Requirement]):
    norm = lambda t: re.sub(r"\s+", "", t)  # noqa: E731
    left = list(old)
    added: list[Requirement] = []
    changed: list[tuple[Requirement, Requirement]] = []
    same = 0
    for n in new:
        exact = next((o for o in left if norm(o.text) == norm(n.text)), None)
        if exact:
            left.remove(exact)
            same += 1
            continue
        best, best_r = None, 0.0
        for o in left:
            r = difflib.SequenceMatcher(None, o.text, n.text).ratio()
            if r > best_r:
                best, best_r = o, r
        if best is not None and best_r >= 0.55:
            left.remove(best)
            changed.append((best, n))
        else:
            added.append(n)
    return added, left, changed, same


def build_diff_report(old_path: str, new_path: str, today: date) -> str:
    old_s = split_sentences(load_text(old_path))
    new_s = split_sentences(load_text(new_path))
    added, removed, changed, same = diff_requirements(extract_requirements(old_s), extract_requirements(new_s))
    lines = ["=" * 60, " 공지 정정 추적 보고서", f" 이전: {old_path}  →  이후: {new_path}",
             f" 변경 없음 {same}개 / 변경 {len(changed)}개 / 추가 {len(added)}개 / 삭제 {len(removed)}개", "=" * 60, ""]

    risky = 0
    if changed:
        lines.append("■ 변경된 요구사항  ([-삭제-] {+추가+})")
        for o, n in changed:
            nums_o, nums_n = re.findall(r"\d+", o.text), re.findall(r"\d+", n.text)
            warn = "  ⚠ 숫자/조건이 바뀜 — 이미 작업한 부분을 다시 확인하세요" if nums_o != nums_n else ""
            risky += bool(warn)
            lines.append(f"  ~ {word_diff(o.text, n.text)}{warn}")
        lines.append("")
    if added:
        lines.append("■ 새로 추가된 요구사항")
        lines += [f"  + ({n.category}/{n.strength}) {n.text}" for n in added]
        lines.append("")
    if removed:
        lines.append("■ 삭제된 요구사항")
        lines += [f"  - {o.text}" for o in removed]
        lines.append("")

    d_old = {(d.day, d.hh, d.mm) for d in extract_deadlines(old_s, today) if d.is_deadline}
    d_new = {(d.day, d.hh, d.mm) for d in extract_deadlines(new_s, today) if d.is_deadline}
    if d_old != d_new:
        fmt = lambda s: ", ".join(  # noqa: E731
            f"{d.isoformat()} {('%02d:%02d' % (h, m)) if h is not None else '시각 없음'}" for d, h, m in sorted(s, key=lambda x: x[0])) or "(없음)"
        lines += ["■ 마감 일정 변경", f"  이전: {fmt(d_old)}", f"  이후: {fmt(d_new)}", ""]
        risky += 1
    if not (changed or added or removed) and d_old == d_new:
        lines.append("요구사항에 의미 있는 변경이 없습니다. (표현만 바뀌었을 수 있음)")
    elif risky:
        lines.append(f"→ 특히 주의할 변경 {risky}건: 체크리스트를 다시 점검하세요.")
    return "\n".join(lines).rstrip() + "\n"


# ======================================================================
# 9. 출력: 화면·보고서 (텍스트 / Markdown / HTML)
# ======================================================================
def format_checklist(cl: Checklist, only_pending: bool = False) -> str:
    lines = []
    for it in cl.items:
        if only_pending and it.done:
            continue
        mark = "x" if it.done else " "
        lines.append(f" {it.id:>2}. [{mark}] ({it.category}/{it.strength}) {it.text}")
        if it.note:
            lines.append(f"        메모: {it.note}")
    return "\n".join(lines) if lines else "  (항목 없음)"


KIND_TITLE = {"모호": "모호한 표현", "충돌": "조건 충돌·모순", "일정": "일정(마감) 문제", "누락": "누락 정보"}


def format_findings(findings: list[Finding]) -> str:
    if not findings:
        return "발견된 문제가 없습니다."
    out = []
    for kind, title in KIND_TITLE.items():
        items = [f for f in findings if f.kind == kind]
        if not items:
            continue
        out.append(f"■ {title} ({len(items)}건)")
        for n, w in enumerate(items, 1):
            where = f" [{', '.join(map(str, w.line_nos))}행]" if w.line_nos else ""
            out.append(f"  {n}. ({w.severity}){where} {w.message}")
            if w.excerpt:
                out.append(f"     원문: {w.excerpt}")
            if w.lenient or w.strict:
                out.append(f"     학생 A(관대하게 읽음): {w.lenient.replace('학생 A: ', '')}")
                out.append(f"     학생 B(엄격하게 읽음): {w.strict.replace('학생 B: ', '')}")
            if w.question:
                out.append(f"     → 확인 질문: {w.question}")
            if w.rewrite:
                out.append(f"     → 고쳐 쓰기: {w.rewrite}")
        out.append("")
    return "\n".join(out).rstrip()


def format_scorecard(sc: Scorecard) -> str:
    rows = [("명확성", sc.clarity), ("일관성", sc.consistency), ("완전성", sc.completeness), ("일  정", sc.schedule)]
    lines = [f"  종합 {sc.total}점  등급 {sc.grade}   {GRADE_COMMENT[sc.grade]}"]
    lines += [f"    {name} {bar(v)} {v:>3}" for name, v in rows]
    return "\n".join(lines)


def prioritized_questions(findings: list[Finding], limit: int = 99) -> list[tuple[Finding, str]]:
    order = {"일정": 0, "충돌": 1, "누락": 2, "모호": 3}
    picks = sorted((f for f in findings if f.question),
                   key=lambda f: (0 if f.severity == "경고" else 1, order.get(f.kind, 9)))
    seen: set[str] = set()
    out = []
    for f in picks:
        if f.question in seen:
            continue
        seen.add(f.question)
        out.append((f, f.question))
        if len(out) >= limit:
            break
    return out


def build_instructor_report(source: str, findings: list[Finding], deadlines: list[DeadlineInfo],
                            today: date) -> str:
    sc = compute_score(findings)
    n_warn = sum(1 for w in findings if w.severity == "경고")
    head = ["=" * 60, " 과제 안내문 건강검진 보고서",
            f" 대상: {source}   생성: {datetime.now():%Y-%m-%d %H:%M}",
            f" 경고 {n_warn}건 / 참고 {len(findings) - n_warn}건", "=" * 60, "",
            "■ 건강 점수", format_scorecard(sc), "",
            f"■ 마감 일정 타임라인 (오늘 {today.isoformat()} 기준)", format_timeline(deadlines, today), "", ""]
    body = format_findings(findings)
    qs = [q for f, q in prioritized_questions(findings) if f.severity == "경고"]
    tail = ["", "-" * 60, "수정 전에 확인할 질문 목록 (경고 항목)"]
    tail += [f"  Q{n}. {q}" for n, q in enumerate(qs, 1)] or ["  (없음)"]
    return "\n".join(head) + body + "\n" + "\n".join(tail) + "\n"


def build_mail(source: str, findings: list[Finding], limit: int = 7) -> str:
    qs = prioritized_questions(findings, limit)
    lines = ["제목: [과제 안내문 문의] 확인 부탁드리는 사항이 있습니다", "",
             "교수님(조교님) 안녕하세요.", "",
             "과제 안내문을 읽다가 아래 내용이 정확히 이해되지 않아 문의드립니다.", ""]
    if not qs:
        lines.append("(자동 점검에서 확인이 필요한 항목이 발견되지 않았습니다.)")
    for n, (f, q) in enumerate(qs, 1):
        quote = ""
        if f.excerpt:
            first = f.excerpt.splitlines()[0].strip()
            quote = f"  (안내문 표현: \"{first[:60]}{'…' if len(first) > 60 else ''}\")"
        lines.append(f"{n}. {q}{quote}")
    lines += ["", "바쁘신 중에 번거롭게 해 드려 죄송합니다. 확인해 주시면 감사하겠습니다.", "",
              "[학번] [이름] 드림", "", f"(출처: {source} 자동 점검 결과)"]
    return "\n".join(lines) + "\n"


def build_student_report(cl: Checklist, today: date) -> str:
    done, total = cl.progress()
    lines = [
        "=" * 60,
        " 제출 전 점검 보고서 (학생용)",
        f" 안내문: {cl.source or '(미지정)'}   생성: {datetime.now():%Y-%m-%d %H:%M}",
        f" 진행률 {progress_bar(done, total)}",
        "=" * 60, "",
    ]
    dls = cl.deadline_infos()
    if dls:
        lines += ["■ 마감 일정", format_timeline(dls, today), ""]
    pending = [i for i in cl.items if not i.done]
    if not pending:
        lines.append("모든 항목을 완료했습니다. 제출 방법과 마감 시각을 마지막으로 확인하세요.")
    else:
        lines.append(f"■ 미완료 항목 {len(pending)}개")
        by_cat: dict[str, list[Requirement]] = {}
        for it in pending:
            by_cat.setdefault(it.category, []).append(it)
        for cat, its in by_cat.items():
            lines.append(f"\n  [{cat}]")
            for it in its:
                lines.append(f"   - ({it.strength}) #{it.id} {it.text}")
                if it.note:
                    lines.append(f"       메모: {it.note}")
    finished = [i for i in cl.items if i.done]
    if finished:
        lines.append(f"\n■ 완료 항목 {len(finished)}개")
        lines += [f"   - #{i.id} {i.text}" for i in finished]
    return "\n".join(lines) + "\n"


def render_html(source: str, findings: list[Finding], deadlines: list[DeadlineInfo], today: date) -> str:
    sc = compute_score(findings)
    esc = html.escape
    color = {"A": "#1a7f37", "B": "#2f80ed", "C": "#b7791f", "D": "#c05621", "F": "#c53030"}[sc.grade]
    axes = [("명확성", sc.clarity), ("일관성", sc.consistency), ("완전성", sc.completeness), ("일정", sc.schedule)]
    parts = [f"""<!doctype html><html lang="ko"><head><meta charset="utf-8">
<title>과제 안내문 건강검진 - {esc(source)}</title>
<style>
body{{font-family:-apple-system,'Malgun Gothic',sans-serif;max-width:860px;margin:2rem auto;padding:0 1rem;color:#222}}
.grade{{font-size:4rem;font-weight:700;color:{color}}} .axis{{display:flex;align-items:center;gap:.6rem;margin:.2rem 0}}
.axis span.n{{width:4rem}} .track{{flex:1;background:#eee;border-radius:6px;height:12px}} .fill{{background:{color};height:12px;border-radius:6px}}
.card{{border:1px solid #ddd;border-left:6px solid #999;border-radius:8px;padding:.7rem 1rem;margin:.7rem 0}}
.card.warn{{border-left-color:#c53030}} .card.info{{border-left-color:#b7791f}}
.tag{{font-size:.75rem;background:#eee;border-radius:4px;padding:1px 6px;margin-right:.4rem}}
.ab{{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin:.4rem 0}} .ab div{{background:#f6f8fa;border-radius:6px;padding:.4rem .6rem;font-size:.9rem}}
.fix{{background:#eef8ee;border-radius:6px;padding:.4rem .6rem;font-size:.9rem}} pre{{white-space:pre-wrap;background:#f6f8fa;padding:.5rem;border-radius:6px}}
</style></head><body>
<h1>과제 안내문 건강검진</h1><p>대상: {esc(source)} · 기준일 {today.isoformat()}</p>
<div style="display:flex;gap:2rem;align-items:center"><div><div class="grade">{sc.grade}</div><div>{sc.total}점</div></div><div style="flex:1">"""]
    for name, v in axes:
        parts.append(f'<div class="axis"><span class="n">{name}</span><div class="track"><div class="fill" style="width:{v}%"></div></div><span>{v}</span></div>')
    parts.append(f"</div></div><p>{esc(GRADE_COMMENT[sc.grade])}</p><h2>마감 일정</h2><pre>{esc(format_timeline(deadlines, today))}</pre>")
    for kind, title in KIND_TITLE.items():
        items = [f for f in findings if f.kind == kind]
        if not items:
            continue
        parts.append(f"<h2>{title} ({len(items)}건)</h2>")
        for f in items:
            cls = "warn" if f.severity == "경고" else "info"
            where = f" · {', '.join(map(str, f.line_nos))}행" if f.line_nos else ""
            parts.append(f'<div class="card {cls}"><span class="tag">{f.severity}</span><b>{esc(f.message)}</b>{where}')
            if f.excerpt:
                parts.append(f"<pre>{esc(f.excerpt)}</pre>")
            if f.lenient or f.strict:
                parts.append(f'<div class="ab"><div><b>학생 A (관대)</b><br>{esc(f.lenient.replace("학생 A: ", ""))}</div>'
                             f'<div><b>학생 B (엄격)</b><br>{esc(f.strict.replace("학생 B: ", ""))}</div></div>')
            if f.question:
                parts.append(f"<p>❓ {esc(f.question)}</p>")
            if f.rewrite:
                parts.append(f'<div class="fix">✏️ {esc(f.rewrite)}</div>')
            parts.append("</div>")
    parts.append("</body></html>")
    return "\n".join(parts)


def write_report(path: str, report_text: str, findings: list[Finding], deadlines: list[DeadlineInfo],
                 source: str, today: date) -> None:
    suffix = Path(path).suffix.lower()
    if suffix in (".html", ".htm"):
        Path(path).write_text(render_html(source, findings, deadlines, today), encoding="utf-8")
    elif suffix == ".md":
        Path(path).write_text("```text\n" + report_text + "```\n", encoding="utf-8")
    else:
        Path(path).write_text(report_text, encoding="utf-8")


# ======================================================================
# 10. 대화형 체크리스트 모드
# ======================================================================
HELP = """명령어
  ls              전체 목록        pending / p   미완료만 보기
  done 1 3 5-7    완료 처리        undo 2        완료 취소
  add 내용        항목 추가        edit 3 내용   항목 수정
  del 4           항목 삭제        note 2 메모   메모 달기
  due             마감 일정 보기   report [파일] 제출 전 점검 보고서 저장
  help            도움말           q             저장하고 종료"""


def parse_ids(args: list[str]) -> list[int]:
    ids: list[int] = []
    for a in args:
        m = re.fullmatch(r"(\d+)-(\d+)", a)
        if m:
            lo, hi = int(m.group(1)), int(m.group(2))
            ids.extend(range(min(lo, hi), min(max(lo, hi), min(lo, hi) + 500) + 1))
        elif a.isdigit():
            ids.append(int(a))
    return ids


def interactive(cl: Checklist, state_path: str, today: date) -> None:
    print("\n" + HELP + "\n")
    print(format_checklist(cl))
    print(progress_bar(*cl.progress()))
    while True:
        try:
            raw = input("\n> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not raw:
            continue
        cmd, *rest = raw.split(maxsplit=1)
        arg = rest[0] if rest else ""
        changed = True

        if cmd in ("q", "quit", "exit"):
            break
        elif cmd in ("ls", "list"):
            print(format_checklist(cl)); changed = False
        elif cmd in ("p", "pending"):
            print(format_checklist(cl, only_pending=True)); changed = False
        elif cmd == "done":
            for i in parse_ids(arg.split()):
                print(f"  #{i} 완료" if cl.set_done(i, True) else f"  #{i} 없음")
        elif cmd == "undo":
            for i in parse_ids(arg.split()):
                print(f"  #{i} 완료 취소" if cl.set_done(i, False) else f"  #{i} 없음")
        elif cmd == "add":
            if arg:
                it = cl.add(arg); print(f"  #{it.id} 추가됨")
            else:
                print("  사용법: add 내용"); changed = False
        elif cmd == "edit":
            parts = arg.split(maxsplit=1)
            if len(parts) == 2 and parts[0].isdigit():
                print("  수정됨" if cl.edit(int(parts[0]), parts[1]) else "  없는 번호")
            else:
                print("  사용법: edit 번호 새내용"); changed = False
        elif cmd in ("del", "rm"):
            for i in parse_ids(arg.split()):
                print(f"  #{i} 삭제" if cl.delete(i) else f"  #{i} 없음")
        elif cmd == "note":
            parts = arg.split(maxsplit=1)
            if len(parts) == 2 and parts[0].isdigit() and cl.get(int(parts[0])):
                cl.get(int(parts[0])).note = parts[1]; print("  메모 저장")
            else:
                print("  사용법: note 번호 메모"); changed = False
        elif cmd == "due":
            print(format_timeline(cl.deadline_infos(), today)); changed = False
        elif cmd == "report":
            out = arg or "student_report.txt"
            Path(out).write_text(build_student_report(cl, today), encoding="utf-8")
            print(f"  저장: {out}"); changed = False
        elif cmd in ("help", "h", "?"):
            print(HELP); changed = False
        else:
            print("  알 수 없는 명령입니다. help 를 입력하세요."); changed = False

        if changed:
            cl.save(state_path)
            print("  " + progress_bar(*cl.progress()))
    cl.save(state_path)
    print(f"저장됨: {state_path}")


# ======================================================================
# 11. 데모 안내문 (일부러 문제를 심어 둔 연습용)
# ======================================================================
DEMO_V1 = """[과제 3] 파이썬 성적 처리 프로그램

1. 학생 성적을 읽어 평균과 등급을 계산하는 프로그램을 구현한다.
2. 코드는 가능하면 함수로 나누어 작성하고 주석을 적절히 달 것.
3. 외부 라이브러리는 사용할 수 없다.
4. 데이터 분석을 위해 pandas를 사용해야 한다.
5. 보고서는 최대 3쪽 이내로 작성하되, 최소 5쪽 이상 상세히 쓴다.
6. 소스코드(.py)와 보고서(.pdf)를 제출한다. 파일명은 학번_이름.zip 으로 한다.
7. 제출 마감은 2026년 11월 20일 목요일까지이다.
"""

DEMO_V2 = """[과제 3] 파이썬 성적 처리 프로그램 (정정)

1. 학생 성적을 읽어 평균과 등급을 계산하는 프로그램을 구현한다.
2. 코드는 함수로 나누어 작성하고 함수마다 주석을 1줄 이상 단다.
3. 외부 라이브러리는 사용할 수 없다. 단, numpy는 허용한다.
4. 보고서는 최대 5쪽 이내로 작성한다.
5. 소스코드(.py)와 보고서(.pdf)를 LMS에 제출한다. 파일명은 학번_이름.zip 으로 한다.
6. 제출 마감은 2026년 11월 21일 토요일 23:59까지이다.
7. 지각 제출은 하루당 10% 감점한다. 문의는 조교 이메일로 한다.
"""


def cmd_demo(args: argparse.Namespace) -> None:
    Path("sample_notice.txt").write_text(DEMO_V1, encoding="utf-8")
    Path("sample_notice_v2.txt").write_text(DEMO_V2, encoding="utf-8")
    print("연습용 안내문을 만들었습니다: sample_notice.txt, sample_notice_v2.txt (정정본)")
    print("  python assignment_linter.py lint sample_notice.txt")
    print("  python assignment_linter.py diff sample_notice.txt sample_notice_v2.txt")


# ======================================================================
# 12. CLI
# ======================================================================
def get_today(args: argparse.Namespace) -> date:
    raw = getattr(args, "today", None)
    if raw:
        try:
            return date.fromisoformat(raw)
        except ValueError:
            sys.exit("--today 는 YYYY-MM-DD 형식이어야 합니다.")
    return date.today()


def cmd_lint(args: argparse.Namespace) -> None:
    today = get_today(args)
    text = load_text(args.file)
    _, findings, deadlines = run_lint(text, today)
    report = build_instructor_report(args.file, findings, deadlines, today)
    print(report)
    if args.output:
        write_report(args.output, report, findings, deadlines, args.file, today)
        print(f"보고서 저장: {args.output}")
    if args.mail:
        Path(args.mail).write_text(build_mail(args.file, findings, args.max_questions), encoding="utf-8")
        print(f"질문 메일 초안 저장: {args.mail}")


def cmd_init(args: argparse.Namespace) -> None:
    today = get_today(args)
    text = load_text(args.file)
    sentences, findings, deadlines = run_lint(text, today)
    cl = Checklist(source=args.file)
    cl.items = extract_requirements(sentences)
    cl.deadlines = [d.to_dict() for d in deadlines if d.is_deadline]
    cl.save(args.state)

    print(f"요구사항 후보 {len(cl.items)}개를 찾았습니다. (최종 판단은 직접 해 주세요)\n")
    print(format_checklist(cl))
    if cl.deadlines:
        print("\n마감 일정")
        print(format_timeline(deadlines, today))
    alerts = [w for w in findings if w.severity == "경고"]
    if alerts:
        print(f"\n⚠ 안내문 자체에 확인이 필요한 부분이 {len(alerts)}건 있습니다. "
              f"자세히 보려면: python {Path(sys.argv[0]).name} lint {args.file}")
    if not args.no_interactive:
        interactive(cl, args.state, today)


def cmd_check(args: argparse.Namespace) -> None:
    if not Path(args.state).exists():
        sys.exit(f"{args.state} 파일이 없습니다. 먼저 init 으로 안내문을 불러오세요.")
    interactive(Checklist.load(args.state), args.state, get_today(args))


def cmd_report(args: argparse.Namespace) -> None:
    if not Path(args.state).exists():
        sys.exit(f"{args.state} 파일이 없습니다.")
    report = build_student_report(Checklist.load(args.state), get_today(args))
    print(report)
    if args.output:
        Path(args.output).write_text(report, encoding="utf-8")
        print(f"보고서 저장: {args.output}")


def cmd_audit(args: argparse.Namespace) -> None:
    items = run_audit(load_text(args.notice), args.target)
    report = format_audit(items, args.target)
    print(report)
    if args.output:
        Path(args.output).write_text(report, encoding="utf-8")
        print(f"보고서 저장: {args.output}")


def cmd_diff(args: argparse.Namespace) -> None:
    report = build_diff_report(args.old, args.new, get_today(args))
    print(report)
    if args.output:
        Path(args.output).write_text(report, encoding="utf-8")
        print(f"보고서 저장: {args.output}")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(description="과제 안내문 린터: 요구사항 누락·모호성 탐지기 v2")
    sub = p.add_subparsers(dest="command", required=True)

    def add_today(sp: argparse.ArgumentParser) -> None:
        sp.add_argument("--today", help="기준 날짜 YYYY-MM-DD (테스트용, 기본: 오늘)")

    s = sub.add_parser("demo", help="연습용 안내문 생성")
    s.set_defaults(func=cmd_demo)

    s = sub.add_parser("lint", help="안내문 건강검진: 모호함·충돌·일정·누락 (출제자용)")
    s.add_argument("file", help="안내문 텍스트 파일 ('-'는 붙여넣기)")
    s.add_argument("-o", "--output", help="보고서 저장 경로 (.txt / .md / .html)")
    s.add_argument("--mail", help="질문 메일 초안 저장 경로")
    s.add_argument("--max-questions", type=int, default=7, help="메일에 넣을 최대 질문 수 (기본 7)")
    add_today(s)
    s.set_defaults(func=cmd_lint)

    s = sub.add_parser("init", help="요구사항 후보 추출 후 체크리스트 시작 (학생용)")
    s.add_argument("file", help="안내문 텍스트 파일 ('-'는 붙여넣기)")
    s.add_argument("-s", "--state", default=DEFAULT_STATE, help=f"저장 파일 (기본 {DEFAULT_STATE})")
    s.add_argument("--no-interactive", action="store_true", help="추출·저장만 하고 종료")
    add_today(s)
    s.set_defaults(func=cmd_init)

    s = sub.add_parser("check", help="저장된 체크리스트 이어서 편집")
    s.add_argument("-s", "--state", default=DEFAULT_STATE)
    add_today(s)
    s.set_defaults(func=cmd_check)

    s = sub.add_parser("report", help="제출 전 점검 보고서 출력/저장")
    s.add_argument("-s", "--state", default=DEFAULT_STATE)
    s.add_argument("-o", "--output", help="보고서 저장 경로")
    add_today(s)
    s.set_defaults(func=cmd_report)

    s = sub.add_parser("audit", help="제출물(폴더/zip) 자동 검수")
    s.add_argument("notice", help="안내문 텍스트 파일")
    s.add_argument("target", help="제출할 폴더 또는 .zip 파일")
    s.add_argument("-o", "--output", help="보고서 저장 경로")
    s.set_defaults(func=cmd_audit)

    s = sub.add_parser("diff", help="공지 정정 추적: 이전/이후 안내문 비교")
    s.add_argument("old", help="이전 안내문")
    s.add_argument("new", help="수정된 안내문")
    s.add_argument("-o", "--output", help="보고서 저장 경로")
    add_today(s)
    s.set_defaults(func=cmd_diff)
    return p


def main() -> None:
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8")
    args = build_parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
